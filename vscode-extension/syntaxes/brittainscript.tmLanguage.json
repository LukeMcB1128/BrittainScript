{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BrittainScript",
  "scopeName": "source.bs",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#function-call" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.bs",
      "match": "#.*$"
    },
    "strings": {
      "name": "string.quoted.double.bs",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.bs",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.bs",
          "match": "\\b(cond|while|for|in|break|continue|end|return)\\b"
        },
        {
          "name": "keyword.declaration.bs",
          "match": "\\b(func)\\b"
        },
        {
          "name": "keyword.other.bs",
          "match": "\\b(add)\\b"
        },
        {
          "name": "keyword.operator.logical.bs",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "builtins": {
      "name": "support.function.builtin.bs",
      "match": "\\b(push|input|len|tonum|tostr|type|clear|absolute|round|floor|ceiling|space|sqrroot|sin|cos|tan)\\b"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.bs",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.bs",
          "match": "\\b(pi)\\b"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.bs",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.bs",
          "match": "(==|!=|>=|<=|>|<)"
        },
        {
          "name": "keyword.operator.assignment.bs",
          "match": "(?<![=!<>])=(?!=)"
        },
        {
          "name": "keyword.operator.arithmetic.bs",
          "match": "[+\\-*/%^]"
        }
      ]
    },
    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.bs" }
      }
    },
    "identifiers": {
      "name": "variable.other.bs",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}
