{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BrittainScript",
  "scopeName": "source.bs",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#interpolated-strings"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "interpolated-strings": {
      "name": "string.quoted.double.interpolated.bs",
      "begin": "\\b[fF]\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.bs",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.bs",
          "begin": "\\$\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#interpolation-braces"
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "interpolation-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#interpolation-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "comments": {
      "name": "comment.line.number-sign.bs",
      "match": "#.*$"
    },
    "strings": {
      "name": "string.quoted.double.bs",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.bs",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.bs",
          "match": "\\b(cond|if|elif|else|while|for|in|break|continue|end|return|try|catch|finally|raise|as|local|discard)\\b"
        },
        {
          "name": "keyword.declaration.bs",
          "match": "\\b(func)\\b"
        },
        {
          "name": "keyword.other.bs",
          "match": "\\b(add)\\b"
        },
        {
          "name": "keyword.operator.logical.bs",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "builtins": {
      "name": "support.function.builtin.bs",
      "match": "\\b(absolute|appendfile|ceiling|chr|clear|cos|createfile|datetime|deletefile|dict|error|fileexists|floor|guiafter|guialert|guibutton|guicanvas|guicheckbox|guiclearcanvas|guiclose|guiconfirm|guidrawline|guidrawoval|guidrawrect|guidrawtext|guientry|guierase|guiframe|guigetitems|guigettext|guigetvalue|guigrid|guiischecked|guilabel|guilist|guilistsize|guimove|guionclick|guionerror|guionkey|guipack|guiplace|guiprompt|guirun|guiselect|guiselectedindex|guisetcolor|guisetfont|guisetitems|guisettext|guisetvalue|guislider|guistoponerror|guitextbox|guititle|guiwindow|input|invoke|jsonload|jsonparse|jsonsave|jsonstringify|len|list|ord|push|pyimport|range|readfile|readlines|round|sin|space|sqrroot|tan|tonum|tostr|type|writefile)\\b(?=\\s*\\()"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.bs",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "constant.language.bs",
          "match": "\\b(pi)\\b"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.bs",
      "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.bs",
          "match": "(==|!=|>=|<=|>|<)"
        },
        {
          "name": "keyword.operator.assignment.bs",
          "match": "(//|[+\\-*/%^])=(?!=)"
        },
        {
          "name": "keyword.operator.assignment.bs",
          "match": "(?<![=!<>])=(?!=)"
        },
        {
          "name": "keyword.operator.arithmetic.bs",
          "match": "//|[+\\-*/%^@]"
        }
      ]
    },
    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.bs"
        }
      }
    },
    "identifiers": {
      "name": "variable.other.bs",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}
