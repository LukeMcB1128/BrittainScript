func max(a, b):
    cond a > b:
        return a
    end
    return b
end

func min(a, b):
    cond a < b:
        return a
    end
    return b
end

func abs(x):
    cond x < 0:
        return x * -1
    end
    return x
end

func clamp(x, low, high):
    cond x < low:
        return low
    end
    cond x > high:
        return high
    end
    return x
end

func factorial(n):
    cond n <= 1:
        return 1
    end
    return n * factorial(n - 1)
end

func pow(base, exp):
    result = 1
    i = 0
    while i < exp:
        result = result * base
        i = i + 1
    end
    return result
end
